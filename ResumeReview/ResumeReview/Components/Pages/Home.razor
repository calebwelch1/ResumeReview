@page "/"
@inject HttpClient Http
@rendermode InteractiveServer

<PageTitle>Azure AI Chat</PageTitle>

<div class="chat-header">
    <div>
        <h1>AI Resume Strategist</h1>
        <p class="lead">Refine resumes, prepare interviews, and get actionable career guidance powered by Azure OpenAI.</p>
    </div>
    <div class="stat-pill" aria-hidden="true">
        <span>🔒</span>
        <span>Private by design</span>
    </div>
</div>

<div class="chat-layout">
    <div class="chat-container">
        <div class="chat-log">
            @foreach (var message in _conversation)
            {
                <div class="@($"chat-bubble {(message.Role == "user" ? "user" : "assistant")}")">
                    <div class="chat-role">@((message.Role == "user") ? "You" : "Azure AI")</div>
                    <div>@message.Content</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-warning" role="alert">@_error</div>
            }
        </div>

        <EditForm Model="_messageInput" OnValidSubmit="SendMessage" FormName="ChatForm">
            <InputTextArea class="form-control" @bind-Value="_messageInput.Message" placeholder="Ask for resume feedback, bullet improvements, or interview prep tips." rows="4" />
            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                <button class="btn btn-primary" type="submit" disabled="@_isSending">@(_isSending ? "Sending..." : "Send")</button>
                <small class="text-muted">Your prompt is sent to your configured Azure OpenAI deployment.</small>
            </div>
        </EditForm>
    </div>

    <aside class="chat-container">
        <h5 class="mb-3">Pro tips</h5>
        <ul class="mb-0" style="color: #c7d2e8; line-height: 1.6; padding-left: 1.1rem;">
            <li>Share the target role and industry so responses reflect the right tone.</li>
            <li>Ask for quantified bullet suggestions to strengthen achievements.</li>
            <li>Request interview flash cards or questions aligned to the job description.</li>
        </ul>
    </aside>
</div>

@code {
    private readonly List<ChatMessageDto> _conversation = new()
    {
        new ChatMessageDto("assistant", "Hi! I can help review resumes and answer career questions. What would you like to know?")
    };

    private readonly MessageInput _messageInput = new();
    private bool _isSending;
    private string? _error;

    private async Task SendMessage()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_messageInput.Message))
        {
            return;
        }

        var trimmed = _messageInput.Message.Trim();
        _conversation.Add(new ChatMessageDto("user", trimmed));
        _messageInput.Message = string.Empty;
        _isSending = true;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/chat", new ChatRequest { Messages = _conversation });
            response.EnsureSuccessStatusCode();

            var chatResponse = await response.Content.ReadFromJsonAsync<ChatResponse>();
            if (chatResponse is not null && !string.IsNullOrWhiteSpace(chatResponse.Reply))
            {
                _conversation.Add(new ChatMessageDto("assistant", chatResponse.Reply));
            }
            else
            {
                _error = "Azure AI returned an empty response.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach Azure AI: {ex.Message}";
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private class MessageInput
    {
        public string? Message { get; set; }
    }
}
